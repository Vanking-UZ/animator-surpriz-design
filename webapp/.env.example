# Переменные окружения Next.js-приложения (webapp/) и Flask-адаптера (webapp/adapter/).
# На сервере значения лежат в /opt/surpriz/webapp.env (см. deploy/systemd/).
# Закомментированные ключи необязательны: в комментарии указано значение по умолчанию.

# --- Next.js ---
# Адрес основного Flask-сайта (на сервере — http://127.0.0.1:5052)
# SURPRIZ_BACKEND_ORIGIN=http://127.0.0.1:5050
# Адрес Flask-адаптера
# SURPRIZ_ADAPTER_ORIGIN=http://127.0.0.1:5051
# Канонический публичный адрес сайта (metadataBase, robots, sitemap)
# SURPRIZ_CANONICAL_URL=https://animator-surpriz.uz
# Origin, на который проксируется /surpriz/* (при `next dev` по умолчанию http://127.0.0.1:4173)
# SURPRIZ_PUBLIC_ASSET_ORIGIN=
# Идентификатор релиза: build id Next.js и метка X-Surpriz-Build-Id
# (запасные источники: VERCEL_GIT_COMMIT_SHA, SOURCE_VERSION; иначе build-<время>)
# SURPRIZ_RELEASE_ID=
# Каталоги медиа админки (по умолчанию ./media и ./public/media)
# SURPRIZ_MEDIA_PRIVATE_ROOT=/var/lib/surpriz/media
# SURPRIZ_MEDIA_PUBLIC_ROOT=/var/www/surpriz-media

# --- Next.js и адаптер ---
# Внутренний токен между Next.js и адаптером (случайная строка, одинаковая для обоих)
SURPRIZ_ADAPTER_TOKEN=

# --- Flask-адаптер (webapp/adapter/app.py) ---
# SURPRIZ_ADAPTER_HOST=127.0.0.1
# SURPRIZ_ADAPTER_PORT=5051
# 1 — secure-cookie сессии адаптера (за HTTPS)
# SURPRIZ_SECURE_COOKIES=0
# Метаданные адаптера храните вне неизменяемого каталога релиза (по умолчанию webapp/data)
# SURPRIZ_ADAPTER_DATA_DIR=/var/lib/surpriz/adapter
# SQLite основного сайта (по умолчанию content/data/admin/site_admin.sqlite3)
# SURPRIZ_CANONICAL_DATABASE=/var/lib/surpriz/site_admin.sqlite3

# --- Тесты (Playwright) ---
# FLASK_BASE_URL=http://127.0.0.1:5152
