# Переменные окружения Flask-сайта (app.py, core/, surpriz/preview.py).
# Скопируйте файл в .env (он не коммитится) и заполните нужные значения.
# Закомментированные ключи необязательны: в комментарии указано значение по умолчанию.
# Пустой ключ без комментария считается незаданным.

# --- Режим и запуск ---
# development | production (по умолчанию development; в production обязателен SURPRIZ_ADMIN_SECRET)
# SURPRIZ_ENV=development
# Адрес и порт встроенного сервера `python app.py` (в продакшене — gunicorn)
# SURPRIZ_HOST=0.0.0.0
# SURPRIZ_PORT=5000
# 1 — запустить встроенный сервер с самоподписанным HTTPS (adhoc)
# SURPRIZ_SSL=0
# 1 — сайт отдаётся по HTTPS: secure-cookie сессии (в production включено всегда)
# SURPRIZ_PUBLIC_HTTPS=0
# Каталог фронтенда-лендинга (по умолчанию ./surpriz или соседний ../surprizopus с data/catalogs.json;
# на сервере — <каталог релиза>/surpriz)
# SURPRIZ_LANDING_ROOT=

# --- Админка ---
# Секрет подписи Flask-сессий (обязателен в production)
SURPRIZ_ADMIN_SECRET=
# Логин и пароль первого администратора: обязательны, пока хранилище админов пустое
SURPRIZ_ADMIN_USERNAME=
SURPRIZ_ADMIN_PASSWORD=
# 1 — явно запросить создание первого администратора (действует только при пустом хранилище)
# SURPRIZ_ADMIN_BOOTSTRAP=0
# Публичный адрес админки для ссылок в Telegram-уведомлениях, например https://animator-surpriz.uz
# ADMIN_PORTAL_BASE=

# --- Telegram ---
# Токен бота уведомлений администраторов (TELEGRAM_BOT_TOKEN — запасное имя)
TELEGRAM_NOTIFY_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# Токен Telegram Gateway для отправки кодов входа клиентам
TELEGRAM_GATEWAY_TOKEN=
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token для /api/tg/webhook (без него вебхук отвечает 503)
TELEGRAM_WEBHOOK_SECRET=
# 1 — запускать long-polling внутри веб-процесса (только локально; в продакшене отдельный воркер)
# SURPRIZ_TELEGRAM_POLLING=0
# background | external | disabled (на сервере — external: polling ведёт surpriz-bot.service)
# TELEGRAM_POLLING_MODE=background

# --- Лимиты кодов входа (Telegram OTP) ---
# TELEGRAM_OTP_PHONE_LIMIT=3
# TELEGRAM_OTP_PHONE_WINDOW_SECONDS=600
# TELEGRAM_OTP_IP_LIMIT=10
# TELEGRAM_OTP_IP_WINDOW_SECONDS=600
# TELEGRAM_OTP_GLOBAL_LIMIT=30
# TELEGRAM_OTP_GLOBAL_WINDOW_SECONDS=60
# TELEGRAM_OTP_RESEND_COOLDOWN_SECONDS=60
# TELEGRAM_OTP_CLEANUP_BATCH_SIZE=500
# TELEGRAM_OTP_DB_BUSY_TIMEOUT_MS=5000

# --- Яндекс Карты ---
YANDEX_MAPS_API_KEY=
YANDEX_SUGGEST_API_KEY=

# --- Только для разработки (в продакшене не включать) ---
# 1 — код входа 000000 принимается для локальных запросов
# CUSTOMER_AUTH_DEV_BYPASS=0
# 1 — демо-занятость в календаре (игнорируется в production)
# SURPRIZ_DEMO_AVAILABILITY=0
# 1 — визуальный пикер элементов (/__inspect/*)
# STAGEWISE=0

# --- Локальный превью лендинга (surpriz/preview.py) ---
# PORT=4173
# SURPRIZ_PREVIEW_SECRET=
# SURPRIZ_PREVIEW_DB_PATH=
